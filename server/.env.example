# Copy to server/.env and fill in. Never commit .env.
PORT=3002

# MySQL from docker-compose.yml (host port 3307). DB_PASSWORD = MYSQL_PASSWORD in the root .env.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=lumiere
DB_PASSWORD=change-me-app
DB_NAME=ecommerce_v2
DB_NAME_TEST=ecommerce_v2_test
# A hosted database (for example Aiven) only accepts encrypted connections: set DB_SSL=true and paste the
# CA certificate text into DB_SSL_CA (write line breaks as \n). Leave both unset for the local MySQL.
# DB_SSL=
# DB_SSL_CA=
# DB_NAME_TEST is only needed in development and tests; a host in production does not set it.

# Set by Docker and by the host in production; leave it unset in development (the server then reads it as development).
# NODE_ENV=

# Long random string, used to sign the sign-in cookie.
JWT_SECRET=change-me-to-a-long-random-string

# Leave unset unless the API runs behind a proxy. Then set the number of proxies, for example 1.
# A host such as Render is one proxy: set 1 there, or every visitor looks like the proxy and shares one rate limit.
# TRUST_PROXY=

# Whether the sign-in cookie is HTTPS only. Leave unset: it is true in production and false otherwise.
# The local Docker run is plain http://localhost, so docker-compose.yml sets it to false.
# COOKIE_SECURE=

# Users created by the seed.
DEMO_CUSTOMER_EMAIL=demo@example.com
DEMO_CUSTOMER_PASSWORD=change-me-demo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
