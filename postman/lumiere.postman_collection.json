{
  "info": {
    "_postman_id": "9c8f2f66-756d-42e9-a033-1527f6d338e8",
    "name": "Lumière API",
    "description": "API checks. See postman/README.md. Run each folder from top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
