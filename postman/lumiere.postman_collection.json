  "item": [
    {
      "name": "Foundation",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Server and database are up. Expect data.status = ok and data.db = ok."
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"8 categories with name and slug\", () => { pm.expect(data).to.have.lengthOf(8); data.forEach((c) => pm.expect(c).to.have.all.keys(\"id\", \"name\", \"slug\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "description": "The 8 categories in menu order."
          }
        },
        {
          "name": "List products (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"12 cards, page 1, total 2242\", () => { pm.expect(data.items).to.have.lengthOf(12); pm.expect(data.page).to.eql(1); pm.expect(data.total).to.eql(2242); });",
                  "pm.test(\"card shape\", () => pm.expect(data.items[0]).to.have.all.keys(\"id\", \"slug\", \"title\", \"priceCents\", \"ratingAvg\", \"reviewCount\", \"imageUrl\", \"imageAlt\", \"soldOut\"));",
                  "const keys = (v) => Array.isArray(v) ? v.flatMap(keys) : (v && typeof v === \"object\") ? Object.entries(v).flatMap(([k, x]) => [k, ...keys(x)]) : [];",
                  "pm.test(\"no stock number in the response\", () => pm.expect(keys(pm.response.json())).to.not.include(\"stock\"));",
                  "pm.collectionVariables.set(\"productSlug\", data.items[0].slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Newest first, 12 per page. Saves the first slug in {{productSlug}} for the requests below."
          }
        },
        {
          "name": "Top rated",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const ratings = pm.response.json().data.items.map((p) => p.ratingAvg);",
                  "pm.test(\"ratings never go up\", () => ratings.forEach((r, i) => { if (i > 0 && r !== null) pm.expect(r).to.be.at.most(ratings[i - 1] ?? 5); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?sort=rating&limit=8",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "rating"
                },
                {
                  "key": "limit",
                  "value": "8"
                }
              ]
            },
            "description": "Highest rating first; products without a rating come last."
          }
        },
        {
          "name": "Filter: dresses under $45, cheapest first",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data.items;",
                  "pm.test(\"every price is 4499 or less\", () => items.forEach((p) => pm.expect(p.priceCents).to.be.at.most(4499)));",
                  "pm.test(\"prices go up\", () => items.forEach((p, i) => { if (i > 0) pm.expect(p.priceCents).to.be.at.least(items[i - 1].priceCents); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=dresses&maxPriceCents=4499&sort=price_asc&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "dresses"
                },
                {
                  "key": "maxPriceCents",
                  "value": "4499"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Category, price limit and sort together."
          }
        },
        {
          "name": "Search by title",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"every title has the word\", () => pm.response.json().data.items.forEach((p) => pm.expect(p.title.toLowerCase()).to.include(\"dress\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?q=dress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "dress"
                }
              ]
            },
            "description": "Title search, ignoring case."
          }
        },
        {
          "name": "Filter options",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"color groups have a key and a label\", () => { pm.expect(data.colors.length).to.be.above(0); data.colors.forEach((c) => pm.expect(c).to.have.all.keys(\"key\", \"label\")); });",
                  "pm.test(\"sizes are text, starting with the usual letter sizes\", () => { pm.expect(data.sizes.length).to.be.above(0); data.sizes.forEach((s) => pm.expect(s).to.be.a(\"string\")); pm.expect(data.sizes.indexOf(\"S\")).to.be.below(data.sizes.indexOf(\"XL\")); });",
                  "const keys = (v) => Array.isArray(v) ? v.flatMap(keys) : (v && typeof v === \"object\") ? Object.entries(v).flatMap(([k, x]) => [k, ...keys(x)]) : [];",
                  "pm.test(\"no stock number in the response\", () => pm.expect(keys(pm.response.json())).to.not.include(\"stock\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/filters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "filters"
              ]
            },
            "description": "Color groups and sizes for the shop filters. Sizes come in a fixed order. No stock numbers."
          }
        },
        {
          "name": "Filter: color black",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"some products, fewer than all 2242\", () => { pm.expect(data.total).to.be.above(0); pm.expect(data.total).to.be.below(2242); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?color=black&limit=8",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "color",
                  "value": "black"
                },
                {
                  "key": "limit",
                  "value": "8"
                }
              ]
            },
            "description": "Only products with an in-stock black variant."
          }
        },
        {
          "name": "Filter: several colors and sizes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"some products\", () => pm.expect(pm.response.json().data.total).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?color=black,white&size=S,M&limit=8",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "color",
                  "value": "black,white"
                },
                {
                  "key": "size",
                  "value": "S,M"
                },
                {
                  "key": "limit",
                  "value": "8"
                }
              ]
            },
            "description": "Black or white, in size S or M (on the same in-stock variant)."
          }
        },
        {
          "name": "Filter: black, M, $25-$50, cheapest first",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data.items;",
                  "pm.test(\"prices are 2500 to 4999\", () => items.forEach((p) => { pm.expect(p.priceCents).to.be.at.least(2500); pm.expect(p.priceCents).to.be.at.most(4999); }));",
                  "pm.test(\"prices go up\", () => items.forEach((p, i) => { if (i > 0) pm.expect(p.priceCents).to.be.at.least(items[i - 1].priceCents); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?color=black&size=M&minPriceCents=2500&maxPriceCents=4999&sort=price_asc&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "color",
                  "value": "black"
                },
                {
                  "key": "size",
                  "value": "M"
                },
                {
                  "key": "minPriceCents",
                  "value": "2500"
                },
                {
                  "key": "maxPriceCents",
                  "value": "4999"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "All filters together. Prices are inside the range and go up."
          }
        },
        {
          "name": "Filter: unknown color gives an empty list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"empty list\", () => { const data = pm.response.json().data; pm.expect(data.items).to.have.lengthOf(0); pm.expect(data.total).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?color=no-such-color",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "color",
                  "value": "no-such-color"
                }
              ]
            },
            "description": "Not an error: just no products."
          }
        },
        {
          "name": "Error: minimum price above maximum",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?minPriceCents=5000&maxPriceCents=2500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "minPriceCents",
                  "value": "5000"
                },
                {
                  "key": "maxPriceCents",
                  "value": "2500"
                }
              ]
            },
            "description": "Expect 400 VALIDATION_ERROR."
          }
        },
        {
          "name": "Error: limit above 48",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=49",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "49"
                }
              ]
            },
            "description": "Expect 400 VALIDATION_ERROR (limit is not clamped)."
          }
        },
        {
          "name": "Product detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().data;",
                  "pm.test(\"has category, images and variants\", () => { pm.expect(p.category).to.have.all.keys(\"name\", \"slug\"); pm.expect(p.images.length).to.be.above(0); pm.expect(p.variants.length).to.be.above(0); });",
                  "pm.test(\"variants use inStock booleans\", () => p.variants.forEach((v) => pm.expect(v.inStock).to.be.a(\"boolean\")));",
                  "const keys = (v) => Array.isArray(v) ? v.flatMap(keys) : (v && typeof v === \"object\") ? Object.entries(v).flatMap(([k, x]) => [k, ...keys(x)]) : [];",
                  "pm.test(\"no stock number in the response\", () => pm.expect(keys(pm.response.json())).to.not.include(\"stock\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productSlug}}"
              ]
            },
            "description": "Run \"List products (default)\" first. Colors, sizes and variants in display order; inStock is true or false, never a number."
          }
        },
        {
          "name": "Related products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data;",
                  "pm.test(\"at most 4, not the same product\", () => { pm.expect(items.length).to.be.at.most(4); items.forEach((p) => pm.expect(p.slug).to.not.eql(pm.collectionVariables.get(\"productSlug\"))); });",
                  "const keys = (v) => Array.isArray(v) ? v.flatMap(keys) : (v && typeof v === \"object\") ? Object.entries(v).flatMap(([k, x]) => [k, ...keys(x)]) : [];",
                  "pm.test(\"no stock number in the response\", () => pm.expect(keys(pm.response.json())).to.not.include(\"stock\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productSlug}}/related",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productSlug}}",
                "related"
              ]
            },
            "description": "Up to 4 from the same category, not the product itself."
          }
        },
        {
          "name": "Error: unknown product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code is NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/no-such-product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "no-such-product"
              ]
            },
            "description": "Expect 404 NOT_FOUND."
          }
        }
      ]
    }
